{
	"schemaVersion": 1,
	"id": "nutonmod",
	"version": "${version}",
	"name": "NutonMod",
	"description": "nuton's first mod",
	"authors": [
		"nuton"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/nutonmod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.nutonmod.NutonMod"
		],
		"terrablender": [
			"com.nutonmod.world.biome.ModTerraBlenderApi"
		],
		"fabric-datagen": [
			"com.nutonmod.NutonModDataGenerator"
		],
		"client": [
			"com.nutonmod.NutonModClient"
		],
		"rei_client": [
			"com.nutonmod.compat.ModREIClientPlugins"
		]
	},
	"mixins": [
		"nutonmod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*",
		"terrablender": "*",
		"customportalapi": "*"
	},
	"suggests": {
		"patchouli": "*"
	},
	"custom": {
		"fabric-api": {
			"disable-resource-pack-validation": true
		}
	}
}
